# ---- Puerto conectado al indicador Rice Lake 480 Legend ----
# Estos valores DEBEN coincidir con el menu SERIAL del indicador.
SCALE_PORT=/dev/serial/by-id/usb-FTDI_FT232R_USB_UART_A50285BI-if00-port0
SCALE_BAUDRATE=9600
SCALE_BYTESIZE=8
SCALE_PARITY=N
SCALE_STOPBITS=1
SCALE_RTSCTS=false
SCALE_XONXOFF=false

# ---- Modo en linea (opcional) ----
# Vacio = tap pasivo: el indicador sigue cableado a la Epson y solo escuchamos.
# Con valor = el puente queda en medio y reenvia los bytes a la impresora.
# PRINTER_PORT=/dev/ttyUSB1
# PRINTER_BAUDRATE=9600

# ---- Framing del ticket ----
IDLE_GAP_S=1.2

# ---- Backend ----
BACKEND_URL=http://10.0.0.20:8000/api/weighings
API_TOKEN=cambiar-por-un-token-largo-y-aleatorio
SCALE_ID=bascula-01
HTTP_TIMEOUT_S=10
MAX_RETRIES=8

# ---- Local ----
SPOOL_DB=/var/lib/rice-lake-bridge/spool.db
RAW_DIR=/var/lib/rice-lake-bridge/raw
DATE_ORDER=dmy
LOG_LEVEL=INFO
